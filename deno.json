{
  "name": "@vetrox/llm-balancer",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./gemini": "./src/providers/gemini/mod.ts",
    "./ollama": "./src/providers/ollama/mod.ts",
    "./openai-compatible": "./src/providers/openai-compatible/mod.ts",
    "./openrouter": "./src/providers/openrouter/mod.ts",
    "./env": "./src/env.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check mod.ts src/providers/gemini/mod.ts src/providers/ollama/mod.ts src/providers/openai-compatible/mod.ts src/providers/openrouter/mod.ts src/env.ts tests && deno test --allow-env"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "publish": {
    "include": ["mod.ts", "src/", "README.md", "LICENSE", "deno.json"]
  }
}
